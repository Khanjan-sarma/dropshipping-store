# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase / Neon / Railway).
# Example: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL=

# Razorpay keys (dashboard -> Settings -> API Keys). Use test keys in dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (dashboard -> Settings -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=
# Public key exposed to the browser for Razorpay Checkout (same as RAZORPAY_KEY_ID).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary. Either provide the single URL or the three discrete values.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin login. Generate the hash with the helper script:
#   npx tsx scripts/hash-password.ts "your-strong-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Public site URL (used for OG tags, absolute links, webhooks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the admin "Confirm on WhatsApp" link and contact page.
# Format: country code + number, digits only. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
